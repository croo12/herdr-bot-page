{
  "name": "herdr-bot",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croo12/herdr-bot-page.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "test": "npm test --workspace renderer && npm run test:native",
    "typecheck": "npm run renderer:typecheck",
    "check": "npm run typecheck && npm test",
    "renderer:typecheck": "tsc -p renderer/tsconfig.json",
    "renderer:build": "npm run build -w @herdr-bot/renderer",
    "renderer:dev": "npm run dev -w @herdr-bot/renderer",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:frontend:dev": "node scripts/build-native-cli.mjs debug && npm run dev -w renderer -- --host 127.0.0.1",
    "tauri:frontend:build": "node scripts/build-native-cli.mjs release && npm run renderer:build",
    "start": "tauri dev",
    "build": "tauri build",
    "test:native": "cargo test --locked --manifest-path native/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.14.0",
    "@tiptap/extension-floating-menu": "3.14.0",
    "@tiptap/core": "3.14.0"
  }
}
